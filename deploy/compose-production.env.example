JUYA_ENVIRONMENT=production
JUYA_ENVIRONMENT_NETWORK=juya-rebuild-production
JUYA_RUNTIME_ENV_FILE=/etc/juya/rebuild/production/admin.env
JUYA_MIGRATION_ENV_FILE=/etc/juya/rebuild/production/migration.env
JUYA_ADMIN_API_IMAGE=juya-admin-api:REPLACE_WITH_VERIFIED_COMMIT
JUYA_MINIAPP_API_IMAGE=juya-miniapp-api:REPLACE_WITH_VERIFIED_COMMIT
JUYA_API_PORT=28001
JUYA_API_MEMORY=448m
JUYA_API_CPUS=0.4
JUYA_WORKER_MEMORY=768m
JUYA_WORKER_CPUS=0.45
JUYA_CPU_SHARES=1024
# Mini overrides: runtime mini.env, API port28002, API CPUs0.8, Worker memory384m/CPUs0.35
JUYA_EXPECTED_OSS_BUCKET=REPLACE_WITH_VERIFIED_PRODUCTION_BUCKET
