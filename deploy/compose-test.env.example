# Copy separately for admin/mini and replace paths, ports and the selected immutable image
JUYA_ENVIRONMENT=test
JUYA_ENVIRONMENT_NETWORK=juya-rebuild-test
JUYA_RUNTIME_ENV_FILE=/etc/juya/rebuild/test/admin.env
JUYA_MIGRATION_ENV_FILE=/etc/juya/rebuild/test/migration.env
JUYA_ADMIN_API_IMAGE=juya-admin-api:REPLACE_WITH_VERIFIED_COMMIT
JUYA_MINIAPP_API_IMAGE=juya-miniapp-api:REPLACE_WITH_VERIFIED_COMMIT
JUYA_API_PORT=18001
JUYA_API_MEMORY=384m
JUYA_API_CPUS=0.4
JUYA_WORKER_MEMORY=512m
JUYA_WORKER_CPUS=0.5
JUYA_CPU_SHARES=256
# Mini overrides: runtime mini.env, port18002, API CPU0.8/memory256m, Worker memory384m
JUYA_EXPECTED_OSS_BUCKET=REPLACE_WITH_VERIFIED_TEST_BUCKET
