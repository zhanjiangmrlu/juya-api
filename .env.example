JUYA_ENVIRONMENT=test
JUYA_DATABASE_URL=mysql+pymysql://juya_test_app:REPLACE_ME@mysql:3306/juya_test?charset=utf8mb4
JUYA_FIELD_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_FERNET_KEY
JUYA_LOOKUP_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JUYA_COOKIE_SECURE=true
JUYA_ALLOWED_ORIGINS=["https://test-admin.juyayingyu.com"]
JUYA_WECHAT_APP_ID=REPLACE_WITH_ACTUAL_APP_ID
JUYA_WECHAT_APP_SECRET=REPLACE_WITH_ACTUAL_APP_SECRET
JUYA_REDIS_URL=redis://:REPLACE_ME@redis-test:6379/0
JUYA_STORAGE_BACKEND=oss
JUYA_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
JUYA_OSS_REGION=cn-shenzhen
JUYA_OSS_BUCKET=REPLACE_WITH_VERIFIED_TEST_BUCKET
JUYA_OSS_ACCESS_KEY_ID=REPLACE_WITH_AUTHORIZED_KEY_ID
JUYA_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_AUTHORIZED_KEY_SECRET
JUYA_TTS_SECRET_ID=REPLACE_WITH_ACTUAL_TENCENT_SECRET_ID
JUYA_TTS_SECRET_KEY=REPLACE_WITH_ACTUAL_TENCENT_SECRET_KEY
JUYA_TTS_VOICE_TYPE=101050
JUYA_TTS_CODEC=mp3
JUYA_TTS_DAILY_BUDGET=2000
JUYA_IMAGE_LIMIT_MB=10
JUYA_AUDIO_LIMIT_MB=50
JUYA_ARCHIVE_LIMIT_MB=100
JUYA_ARCHIVE_EXPANDED_LIMIT_MB=500
JUYA_IMPORT_CARD_LIMIT=50
# Feedback text/image safety is temporarily optional. true requires a strict final-allow gateway.
JUYA_FEEDBACK_SAFETY_ENABLED=false
JUYA_FEEDBACK_SAFETY_URL=
JUYA_FEEDBACK_SAFETY_TOKEN=

# Enable only after both API roles and clients have been upgraded and verified
JUYA_LEARNING_ACCESS_ACTIVATION_READY=false
