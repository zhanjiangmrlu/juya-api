[Unit]
Description=Juya aggregate health and alarm collection
After=docker.service nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/juya/rebuild/operations/monitor.py
TimeoutStartSec=90
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/juya-rebuild-monitor
StateDirectory=juya-rebuild-monitor
PrivateTmp=true
